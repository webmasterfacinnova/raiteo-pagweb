---
import Layout from "../layouts/Layout.astro";
import DriverFeaturesSection from "../components/DriverFeaturesSection.astro";
import HeroSection from "../components/HeroSection.astro";
import LegalComplianceSection from "../components/LegalComplianceSection.astro";
import PassengerFeaturesSection from "../components/PassengerFeaturesSection.astro";
---

<Layout
	title="Raiteo by Facinnovations | Landing Page"
	description="Landing oficial de Raiteo: transporte especializado para pasajeros y conductores con gestión de rutas, mapas en tiempo real y dirección de destino inteligente."
>
	<HeroSection />
	<PassengerFeaturesSection />
	<DriverFeaturesSection />
	<LegalComplianceSection />
</Layout>

<script is:inline>
	// Progressive enhancement: activate reveal animations only when motion is allowed.
	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (!prefersReducedMotion) {
		const revealElements = document.querySelectorAll("[data-reveal]");

		// One-time observer keeps runtime cost low and aligns with Astro performance goals.
		const revealObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("in-view");
						observer.unobserve(entry.target);
					}
				});
			},
			{
				threshold: 0.2,
				rootMargin: "0px 0px -5% 0px",
			},
		);

		revealElements.forEach((element) => {
			element.classList.add("reveal");
			revealObserver.observe(element);
		});
	} else {
		document.querySelectorAll("[data-reveal]").forEach((element) => {
			element.classList.add("in-view");
		});
	}
</script>
