---
// Sección de contacto
---

<section class="contact section" id="contact">
  <div class="container">
    <div class="text-center" data-aos="fade-up" data-aos-duration="700">
      <span class="section-label">Contacto</span>
      <h2 class="section-title">¿Tienes dudas? Escríbenos</h2>
      <p class="section-subtitle">
        Estamos aquí para ayudarte. Contáctanos y te responderemos a la brevedad.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Formulario -->
      <div class="contact-form-wrapper" data-aos="fade-right" data-aos-duration="700">
        <form class="contact-form" id="contactForm" >
          <div class="form-group">
            <label for="name">Nombre completo</label>
            <input type="text" id="name" name="name" placeholder="Tu nombre" required />
          </div>
          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" placeholder="tu@email.com" required />
          </div>
          <div class="form-group">
            <label for="subject">Asunto</label>
            <select id="subject" name="subject">
              <option value="">Selecciona un asunto</option>
              <option value="soporte">Soporte técnico</option>
              <option value="conductor">Quiero ser conductor</option>
              <option value="empresa">Alianza empresarial</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Mensaje</label>
            <textarea id="message" name="message" rows="5" placeholder="Escribe tu mensaje aquí..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-large form-submit">
            Enviar mensaje
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        </form>
      </div>

      <!-- Info de contacto -->
      <div class="contact-info" data-aos="fade-left" data-aos-duration="700">
        <div class="info-card">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <h4>Email</h4>
            <p>soporte@raiteo.app</p>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <h4>Oficina</h4>
            <p>Av. Innovación 1234, Ciudad</p>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          </div>
          <div>
            <h4>Teléfono</h4>
            <p>+52 (123) 456-7890</p>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <h4>Horario</h4>
            <p>Lun - Vie: 9:00 - 18:00</p>
          </div>
        </div>

        <!-- Descarga -->
        <div class="download-card" id="download">
          <h4>Descarga la app</h4>
          <div class="store-buttons">
            <a href="#" class="store-btn" aria-label="Descargar en Google Play">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3.6 1.2L14.4 12 3.6 22.8A2 2 0 0 1 2 21V3a2 2 0 0 1 1.6-1.8zM16.2 13.8l3.6-3.6-3.6-3.6L14.4 12l1.8 1.8z"/></svg>
              Google Play
            </a>
            <a href="#" class="store-btn" aria-label="Descargar en App Store">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
              App Store
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-off-white);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 1000px;
    margin: 0 auto;
    align-items: start;
  }

  .contact-form {
    background: var(--color-white);
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-light-gray);
  }

  .form-group {
    margin-bottom: 1.2rem;
  }

  .form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    font-family: var(--font-sans);
    border: 1.5px solid var(--color-light-gray);
    border-radius: var(--radius-sm);
    background: var(--color-off-white);
    color: var(--color-text);
    transition: all var(--transition-fast);
    outline: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(110, 115, 125, 0.1);
    background: var(--color-white);
  }

  .form-submit {
    width: 100%;
    margin-top: 0.5rem;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-light-gray);
    transition: all var(--transition-base);
  }

  .info-card:hover {
    border-color: var(--color-primary-lighter);
    box-shadow: var(--shadow-sm);
  }

  .info-icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: var(--color-primary-bg);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }

  .info-card h4 {
    font-size: 0.85rem;
    color: var(--color-text-light);
    margin-bottom: 2px;
    font-weight: 500;
  }

  .info-card p {
    font-size: 0.95rem;
    color: var(--color-text);
    font-weight: 600;
  }

  .download-card {
    margin-top: 1rem;
    padding: 1.5rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-light-gray);
  }

  .download-card h4 {
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .store-buttons {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .store-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.2rem;
    background: var(--color-dark);
    color: var(--color-white);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .store-btn:hover {
    background: var(--color-primary-dark);
    color: var(--color-white);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact-form {
      padding: 1.8rem;
    }
  }
</style>