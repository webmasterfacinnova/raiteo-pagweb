---
// Sección de contacto (Astro component)
import { CONTACT_EMAIL, ADDRESS, PHONE, BUSSINESS_HOURS, CONTACT_MAILTO,playStoreUrl } from "../lib/appConfigs";
import { siGoogleplay,siAppstore } from 'simple-icons';
---

<section class="contact section" id="contact">
  <div class="container">
    <div class="text-center">
      <span class="section-label">Contacto</span>
      <h2 class="section-title">¿Tienes dudas? Escríbenos</h2>
      <p class="section-subtitle">
        Estamos aquí para ayudarte. Contáctanos y te responderemos a la brevedad.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Formulario -->
      <div class="contact-form-wrapper" id="contact-component" data-mailto={CONTACT_MAILTO}>
        <form class="contact-form" id="contactForm" method="GET" action={`mailto:${CONTACT_EMAIL}`}>
          <div class="form-group">
            <label for="name">Nombre completo</label>
            <input type="text" id="name" name="name" placeholder="Tu nombre" required />
          </div>
          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" placeholder="tu@email.com" required />
          </div>
          <div class="form-group">
            <label for="subject">Asunto</label>
            <select id="subject" name="subject">
              <option value="">Selecciona un asunto</option>
              <option value="soporte">Soporte técnico</option>
              <option value="conductor">Quiero ser conductor</option>
              <option value="empresa">Alianza empresarial</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Mensaje</label>
            <textarea id="message" name="message" rows="5" placeholder="Escribe tu mensaje aquí..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-large form-submit">
            Enviar mensaje
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13" />
              <polygon points="22 2 15 22 11 13 2 9 22 2" />
            </svg>
          </button>
        </form>
      </div>

      <!-- Info de contacto -->
      <div class="contact-info">
        <div class="info-card">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </div>
          <div>
            <h4>Email</h4>
            <p>{CONTACT_EMAIL}</p>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </div>
          <div>
            <h4>Oficina</h4>
            <p>{ADDRESS}</p>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" />
              <line x1="12" y1="18" x2="12.01" y2="18" />
            </svg>
          </div>
          <div>
            <h4>Teléfono</h4>
            <p>{PHONE}</p>
          </div>
        </div>
        <div class="info-card">
          <div class="info-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          </div>
          <div>
            <h4>Horario</h4>
            <p>{BUSSINESS_HOURS}</p>
          </div>
        </div>

        <!-- Descarga -->
        <div class="download-card" id="download">
          <h4>Descarga la app</h4>
          <div class="store-buttons">
            <a href={playStoreUrl} class="store-btn" aria-label="Descargar en Google Play">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
							<path d={siGoogleplay.path} />
						</svg>
              Google Play
            </a>
            
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .contact {
    background: var(--color-off-white);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 1000px;
    margin: 0 auto;
    align-items: start;
  }

  .contact-form {
    background: var(--color-white);
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-light-gray);
  }

  .form-group {
    margin-bottom: 1.2rem;
  }

  .form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    font-family: var(--font-sans);
    border: 1.5px solid var(--color-light-gray);
    border-radius: var(--radius-sm);
    background: var(--color-off-white);
    color: var(--color-text);
    transition: all var(--transition-fast);
    outline: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(110, 115, 125, 0.1);
    background: var(--color-white);
  }

  .form-submit {
    width: 100%;
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-light-gray);
    transition: all var(--transition-base);
  }

  .info-card:hover {
    border-color: var(--color-primary-lighter);
    box-shadow: var(--shadow-sm);
  }

  .info-icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: var(--color-primary-bg);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }

  .info-card h4 {
    font-size: 0.85rem;
    color: var(--color-text-light);
    margin-bottom: 2px;
    font-weight: 500;
  }

  .info-card p {
    font-size: 0.95rem;
    color: var(--color-text);
    font-weight: 600;
  }

  .download-card {
    margin-top: 1rem;
    padding: 1.5rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-light-gray);
  }

  .download-card h4 {
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .store-buttons {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.2rem;
    background: var(--color-dark);
    color: var(--color-white);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .store-btn:hover {
    background: var(--color-primary-dark);
    color: var(--color-white);
    transform: translateY(-2px);
  }

  .notification-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-dark);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    font-size: 0.9rem;
    z-index: 1000;
    box-shadow: var(--shadow-md);
    animation: fadeInUp 0.3s ease;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .contact-form {
      padding: 1.8rem;
    }
  }
</style>

<script>
  document.addEventListener('astro:load', () => {
    const form = document.getElementById('contactForm') as HTMLFormElement | null;

    // Si el formulario no existe en la página, no hacemos nada
    if (!form) return;

    // Escuchamos el submit INMEDIATAMENTE
    form.addEventListener('submit', (e) => {
      // 1. Evitamos la recarga de la página en la primera línea
      e.preventDefault(); 
      
      // 2. Buscamos los inputs DENTRO del evento para asegurar que están en el DOM
      const component = document.getElementById('contact-component');
      const nameInput = document.getElementById('name') as HTMLInputElement | null;
      const emailInput = document.getElementById('email') as HTMLInputElement | null;
      const subjectSelect = document.getElementById('subject') as HTMLSelectElement | null;
      const messageTextarea = document.getElementById('message') as HTMLTextAreaElement | null;

      // Validación interna: Si falta algún campo en el HTML, avisamos en consola para debuguear
      if (!component || !nameInput || !emailInput || !subjectSelect || !messageTextarea) {
        console.error("Error: No se encontraron todos los elementos del formulario en el DOM.");
        return;
      }

      const contactMailto = component.dataset.mailto || '';
      const subjectValue = subjectSelect.value;
      let subjectText = '';

      switch(subjectValue) {
        case 'soporte': subjectText = 'Soporte técnico'; break;
        case 'conductor': subjectText = 'Quiero ser conductor'; break;
        case 'empresa': subjectText = 'Alianza empresarial'; break;
        case 'otro': subjectText = 'Otro asunto'; break;
        default: subjectText = 'Contacto';
      }
      
      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const message = messageTextarea.value.trim();
      
      const body = `Nombre: ${name}\nCorreo: ${email}\n\nMensaje:\n${message}`;
      const mailtoUrl = `${contactMailto}?subject=${encodeURIComponent(subjectText)}&body=${encodeURIComponent(body)}`;
      
      // 3. CAMBIO CLAVE: Usamos location.href en lugar de window.open
      // Esto previene que el navegador lo bloquee como una ventana emergente (pop-up)
      window.location.href = mailtoUrl;
      
      // 4. Limpiamos el formulario
      // form.reset();
    });
  });
</script>