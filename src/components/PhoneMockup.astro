---
interface Props {
  role: "Passenger" | "Driver";
  title: string;
  caption: string;
  accent: "emerald" | "amber";
}

const { role, title, caption, accent } = Astro.props;

const accentColor = accent === "emerald" ? "bg-emerald-500" : "bg-amber-500";
const chipColor = accent === "emerald" ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700";
---

<article class="reveal w-full max-w-72.5" data-reveal>
  <div class="mockup-glow relative rounded-[2.4rem] border border-slate-200 bg-white p-2">
    <div class="relative overflow-hidden rounded-4xl border border-slate-200 bg-slate-50 p-4">
      <div class="mx-auto mb-4 h-1.5 w-16 rounded-full bg-slate-300"></div>

      <header class="mb-4 flex items-center justify-between">
        <span class={`rounded-full px-2.5 py-1 text-xs font-semibold ${chipColor}`}>{role}</span>
        <span class={`h-2.5 w-2.5 rounded-full ${accentColor}`}></span>
      </header>

      <div class="rounded-2xl border border-slate-200 bg-white p-3">
        <div class="mb-2 h-2.5 w-24 rounded-full bg-slate-200"></div>
        <div class="mb-4 h-2.5 w-36 rounded-full bg-slate-200"></div>

        <div class="mb-4 grid grid-cols-2 gap-2">
          <div class="h-14 rounded-xl bg-slate-100"></div>
          <div class="h-14 rounded-xl bg-slate-100"></div>
        </div>

        <div class="h-24 rounded-2xl bg-linear-to-br from-slate-100 via-slate-50 to-slate-200 p-2">
          <svg viewBox="0 0 100 48" class="h-full w-full">
            <path d="M4 30 C24 4, 54 44, 96 16" fill="none" stroke="#6e737d" stroke-width="2.4" stroke-linecap="round"></path>
            <circle cx="20" cy="24" r="2.5" fill="#10b981"></circle>
            <circle cx="74" cy="18" r="2.5" fill="#f59e0b"></circle>
          </svg>
        </div>
      </div>

      <div class="mt-4 px-1">
        <h3 class="font-display text-base font-bold text-slate-900">{title}</h3>
        <p class="mt-1 text-sm text-slate-600">{caption}</p>
      </div>
    </div>
  </div>
</article>
