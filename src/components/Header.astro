---
// Header con navegación sticky
import { siGoogleplay } from 'simple-icons';
import { playStoreUrl } from '../lib/appConfigs';
---

<header class="header" id="header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Raiteo - Inicio">
      <span class="logo-icon">
        <img src="/Raiteo_logo_.png" alt="Raiteo Logo" width="32" height="32">
      </span>
      <span class="logo-text">Raiteo</span>
    </a>

    <nav class="nav" id="nav">
      <ul class="nav-list">
        <li><a href="/#how-it-works">Cómo funciona</a></li>
        <li><a href="/#features">Características</a></li>
        <li><a href="/#mocks">Demo</a></li>
        <li><a href="/#contact">Contacto</a></li>
      </ul>
      <!-- Botón de descarga visible solo en móvil dentro del menú desplegable -->
      <a href={playStoreUrl} class="btn btn-primary mobile-download-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d={siGoogleplay.path} />
        </svg>
        Descargar App
      </a>
    </nav>

    <div class="header-actions">
      <a href={playStoreUrl} class="btn btn-primary btn-sm">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d={siGoogleplay.path} />
        </svg>
        Descargar App
      </a>
      <button class="mobile-toggle" id="mobileToggle" aria-label="Menú">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: all var(--transition-base);
    height: var(--header-height);
  }

  .header.scrolled {
    border-bottom-color: var(--color-light-gray);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-dark);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    z-index: 1001;
  }

  .logo-icon {
    display: flex;
    align-items: center;
    filter: drop-shadow(#000000 0px 0px 2px)
  }

  .logo-text {
    background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-list {
    display: flex;
    gap: 2rem;
  }

  .nav-list a {
    color: var(--color-text);
    font-weight: 500;
    font-size: 0.95rem;
    position: relative;
    padding: 0.3rem 0;
  }

  .nav-list a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-primary);
    border-radius: 2px;
    transition: width var(--transition-base);
  }

  .nav-list a:hover::after,
  .nav-list a:focus-visible::after {
    width: 100%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-sm {
    padding: 0.55rem 1.2rem;
    font-size: 0.85rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 1001;
  }

  .mobile-toggle span {
    display: block;
    width: 24px;
    height: 2.5px;
    background: var(--color-dark);
    border-radius: 3px;
    transition: all var(--transition-fast);
  }

  .mobile-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Botón de descarga exclusivo para móvil (dentro del menú desplegable) */
  .mobile-download-btn {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-toggle {
      display: flex;
    }

    .header-actions .btn {
      display: none;
    }

    /* Menú desplegable hacia abajo */
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-white);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
      border-radius: 0 0 1rem 1rem;
      padding: 1.25rem 1.5rem;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem);
      transition: all var(--transition-base);
      z-index: 999;
    }

    .nav.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
      width: 100%;
    }

    .nav-list li {
      width: 100%;
      border-bottom: 1px solid var(--color-light-gray);
    }

    .nav-list li:last-child {
      border-bottom: none;
    }

    .nav-list a {
      display: block;
      padding: 0.875rem 0;
      font-size: 1.1rem;
      text-align: left;
    }

    .nav-list a::after {
      display: none;
    }

    /* Botón de descarga dentro del menú desplegable */
    .mobile-download-btn {
      display: flex;
      justify-content: center;
      margin-top: 1.25rem;
      width: 100%;
    }
  }
</style>

<script>
  // Sticky header
  const header = document.getElementById('header');
  window.addEventListener('scroll', () => {
    if (header === null) return;

    if (window.scrollY > 50) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  });

  // Elementos del menú móvil
  const mobileToggle = document.getElementById('mobileToggle');
  const nav = document.getElementById('nav');

  function closeMenu() {
    mobileToggle?.classList.remove('active');
    nav?.classList.remove('active');
  }

  function openMenu() {
    mobileToggle?.classList.add('active');
    nav?.classList.add('active');
  }

  // Alternar menú al hacer clic en el botón hamburguesa
  mobileToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (nav?.classList.contains('active')) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Cerrar menú al hacer clic en cualquier enlace del nav (incluyendo botón de descarga móvil)
  document.querySelectorAll('.nav a').forEach(link => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  // Cerrar menú si se hace clic fuera de él (solo cuando está abierto)
document.addEventListener('click', (e) => {
  if (nav && nav.classList.contains('active')) {
    // Validamos estrictamente que e.target sea un nodo real del DOM
    if (e.target instanceof Node) {
      const isClickInside = nav.contains(e.target) || mobileToggle?.contains(e.target);
      if (!isClickInside) {
        closeMenu();
      }
    }
  }
});

  // Al redimensionar a escritorio, cerrar el menú si estuviera abierto
  window.addEventListener('resize', () => {
    if (window.innerWidth > 768 && nav?.classList.contains('active')) {
      closeMenu();
    }
  });
</script>